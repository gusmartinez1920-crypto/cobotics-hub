---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import EntryHeader from "../../../components/EntryHeader.astro";
import { useT, type Lang } from "../../../i18n/ui";
import { alternatesFor, entries, splitId, translationsOf } from "../../../lib/content";

export async function getStaticPaths() {
  const all = await entries("tutorials");
  return all.map((entry) => ({ params: splitId(entry.id), props: { entry } }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { Content } = await render(entry);
const translations = await translationsOf("tutorials", entry);
const alternates = alternatesFor("tutorials", lang, splitId(entry.id).slug, translations);
const d = entry.data;
---

<Base lang={lang} title={d.title} description={d.description} alternates={alternates}>
  <article class="wrap">
    <EntryHeader lang={lang} section="tutorials" data={d} translations={translations} />
    <dl class="facts">
      <div><dt>{t("meta.duration")}</dt><dd>{d.duration} · {t(`difficulty.${d.difficulty}`)}</dd></div>
      {d.hardware.length > 0 && <div><dt>{t("meta.hardware")}</dt><dd>{d.hardware.join(", ")}</dd></div>}
      {d.repo && <div><dt>{t("meta.repo")}</dt><dd><a href={d.repo}>{d.repo.replace(/^https?:\/\//, "")}</a></dd></div>}
    </dl>
    <div class="prose">
      <Content />
      {d.aiAssisted && entry.data.humanReviewed && <p class="ai">{t("meta.ai")}</p>}
    </div>
  </article>
</Base>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    max-width: var(--measure);
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite-soft);
  }
  dd {
    margin: 0;
  }
  .ai {
    margin-top: 2.5rem;
    font-size: var(--step--1);
    color: var(--graphite-soft);
    font-style: italic;
  }
</style>
