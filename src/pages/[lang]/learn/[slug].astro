---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import EntryHeader from "../../../components/EntryHeader.astro";
import { useT, type Lang } from "../../../i18n/ui";
import { alternatesFor, entries, splitId, translationsOf } from "../../../lib/content";

export async function getStaticPaths() {
  const all = await entries("articles");
  return all.map((entry) => ({ params: splitId(entry.id), props: { entry } }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { Content } = await render(entry);
const translations = await translationsOf("articles", entry);
const alternates = alternatesFor("learn", lang, splitId(entry.id).slug, translations);
---

<Base lang={lang} title={entry.data.title} description={entry.data.description} alternates={alternates}>
  <article class="wrap">
    <EntryHeader lang={lang} section="learn" data={entry.data} translations={translations} />
    <div class="prose">
      <Content />
      {entry.data.aiAssisted && entry.data.humanReviewed && <p class="ai">{t("meta.ai")}</p>}
    </div>
  </article>
</Base>

<style>
  .ai {
    margin-top: 2.5rem;
    font-size: var(--step--1);
    color: var(--graphite-soft);
    font-style: italic;
  }
</style>
