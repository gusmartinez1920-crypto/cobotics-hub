---
// Diretório de cursos de cobótica de terceiros. Dados em src/data/courses.ts.
import Base from "../../layouts/Base.astro";
import { formatDate, langs, type Lang } from "../../i18n/ui";
import { COURSE_GROUPS, COURSES_CHECKED, courses, coursesText } from "../../data/courses";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tx = coursesText[lang];
const groups = COURSE_GROUPS.map((g) => ({ id: g, name: tx.groups[g], items: courses.filter((c) => c.group === g) }));
---

<Base lang={lang} title={tx.title} description={tx.lead}>
  <div class="wrap">
    <header class="page-head">
      <h1>{tx.title}</h1>
      <p class="lead">{tx.lead}</p>
      <p class="notice">{tx.caution}</p>
    </header>

    <nav class="groups" aria-label={tx.title}>
      {groups.map((g) => <a href={`#${g.id}`}>{g.name} <span>{g.items.length}</span></a>)}
    </nav>

    {groups.map((g) => (
      <section class="group" id={g.id}>
        <h2>{g.name}</h2>
        <ul class="list">
          {g.items.map((c) => (
            <li class="item">
              <p class="provider">{c.provider}</p>
              <h3>{c.name}</h3>
              <p class="tags">
                <span class={`cost cost-${c.cost}`}>{tx.cost[c.cost]}</span>
                <span>{tx.langLabel}: {c.languages[lang]}</span>
              </p>
              <p>{c.summary[lang]}</p>
              <p class="src"><a href={c.url} rel="noopener">{tx.open} →</a></p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="gaps">
      <h2>{tx.gapsTitle}</h2>
      <ul>{tx.gaps.map((g) => <li>{g}</li>)}</ul>
    </section>

    <p class="checked">{tx.checked} <time datetime={COURSES_CHECKED}>{formatDate(lang, new Date(COURSES_CHECKED))}</time>.</p>
  </div>
</Base>

<style>
  .notice {
    max-width: 62ch;
    margin-top: 1rem;
  }
  .groups {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-bottom: 2rem;
    font-size: var(--step--1);
  }
  .groups span {
    font-family: var(--font-mono);
    color: var(--graphite-soft);
  }
  .group {
    margin-bottom: 2.5rem;
    scroll-margin-top: 5rem;
  }
  .group h2,
  .gaps h2 {
    font-size: var(--step-1);
    margin-bottom: 1rem;
  }
  .list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
  }
  .item {
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .provider {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite-soft);
    margin-bottom: 0.2rem;
  }
  .item h3 {
    font-size: var(--step-0);
    margin-bottom: 0.4rem;
  }
  .item p {
    margin-bottom: 0.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    font-size: var(--step--1);
    color: var(--graphite-soft);
  }
  .cost {
    font-family: var(--font-mono);
  }
  .cost-free {
    color: var(--sense);
  }
  .item .src {
    font-size: var(--step--1);
    margin: 0;
  }
  .gaps {
    max-width: 48rem;
    margin-bottom: 2rem;
    padding: 1.25rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
  }
  .gaps ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .gaps li {
    margin-bottom: 0.4rem;
  }
  .checked {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite-soft);
  }
</style>
