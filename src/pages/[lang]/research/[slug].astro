---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import EntryHeader from "../../../components/EntryHeader.astro";
import { useT, type Lang } from "../../../i18n/ui";
import { alternatesFor, entries, splitId, translationsOf } from "../../../lib/content";

export async function getStaticPaths() {
  const all = await entries("research");
  return all.map((entry) => ({ params: splitId(entry.id), props: { entry } }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { Content } = await render(entry);
const translations = await translationsOf("research", entry);
const alternates = alternatesFor("research", lang, splitId(entry.id).slug, translations);
const { paper } = entry.data;
const paperHref = paper.doi ? `https://doi.org/${paper.doi}` : paper.url;
---

<Base lang={lang} title={entry.data.title} description={entry.data.description} alternates={alternates}>
  <article class="wrap">
    <EntryHeader
      lang={lang}
      section="research"
      data={entry.data}
      translations={translations}
      bylineLabel={t("paper.summaryBy")}
    />

    <div class="layout">
      <aside class="ref" aria-label={t("paper.original")}>
        <p class="eyebrow">{t("paper.original")}</p>
        <p class="ref-title">{paper.title}</p>
        <p class="ref-authors">{paper.authors.join(", ")}</p>
        <p class="ref-venue">{paper.venue}, {paper.year}</p>
        {paper.doi && <p class="ref-doi">DOI <a href={paperHref}>{paper.doi}</a></p>}
        {!paper.doi && <p><a href={paperHref}>{paperHref}</a></p>}
        {paper.openAccess && <p class="open">{t("paper.open")}{paper.license ? ` · ${paper.license}` : ""}</p>}
      </aside>

      <div class="prose">
        <h2>{t("paper.why")}</h2>
        <p class="why">{entry.data.whyItMatters}</p>

        <Content />

        <h2>{t("paper.method")}</h2>
        <p>{entry.data.method}</p>

        <h2>{t("paper.findings")}</h2>
        <ul>{entry.data.findings.map((f) => <li>{f}</li>)}</ul>

        <h2>{t("paper.limitations")}</h2>
        <p>{entry.data.limitations}</p>

        <hr />
        <p class="disclaimer">{t("paper.disclaimer")}</p>
        {entry.data.aiAssisted && entry.data.humanReviewed && <p class="disclaimer">{t("meta.ai")}</p>}
      </div>
    </div>
  </article>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .ref {
    position: sticky;
    top: 5rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--twin);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }
  .ref p {
    margin-bottom: 0.5rem;
  }
  .ref-title {
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.35;
  }
  .ref-doi,
  .ref-venue {
    font-family: var(--font-mono);
  }
  .ref-doi a {
    word-break: break-all;
  }
  .open {
    color: var(--sense);
    font-family: var(--font-mono);
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .why {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .disclaimer {
    font-size: var(--step--1);
    color: var(--graphite-soft);
  }
  @media (max-width: 52rem) {
    .layout {
      grid-template-columns: 1fr;
    }
    .ref {
      position: static;
    }
  }
</style>
