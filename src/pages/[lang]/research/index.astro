---
import Base from "../../../layouts/Base.astro";
import EntryCard from "../../../components/EntryCard.astro";
import PillarFilter from "../../../components/PillarFilter.astro";
import { langs, path, useT, type Lang, type UIKey } from "../../../i18n/ui";
import { RESEARCH_TOPICS } from "../../../content.config";
import { entries, presentSdgs, splitId } from "../../../lib/content";

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const list = await entries("research", lang);

// Agrupa por tema, na ordem de RESEARCH_TOPICS; dentro do tema, artigos mais recentes primeiro.
const byPaper = (a: (typeof list)[number], b: (typeof list)[number]) =>
  b.data.paper.year - a.data.paper.year || a.data.title.localeCompare(b.data.title, lang);
const groups = [
  ...RESEARCH_TOPICS.map((topic) => ({
    id: topic as string,
    name: t(`topic.${topic}` as UIKey),
    items: list.filter((e) => e.data.topic === topic).sort(byPaper),
  })),
  { id: "other", name: t("research.other"), items: list.filter((e) => !e.data.topic).sort(byPaper) },
].filter((g) => g.items.length > 0);
---

<Base lang={lang} title={t("research.title")} description={t("research.lead")}>
  <div class="wrap">
    <header class="page-head">
      <h1>{t("research.title")}</h1>
      <p class="lead">{t("research.lead")}</p>
      {list.length > 0 && <p class="who"><a href={path(lang, "researchers")}>{t("who.link")} →</a></p>}
    </header>
    {list.length === 0 ? (
      <div class="empty">
        <p>{t("list.empty.research")}</p>
        <p>{t("contribute.summary.desc")}</p>
        <a class="button primary" href={path(lang, "contribute")}>{t("list.empty.cta")}</a>
      </div>
    ) : (
      <>
        <PillarFilter lang={lang} target="papers" sdgs={presentSdgs(list)} />
        {groups.length > 1 && (
          <nav class="topics" aria-label={t("research.topics")}>
            {groups.map((g) => (
              <a href={`#${g.id}`}>{g.name} <span>{g.items.length}</span></a>
            ))}
          </nav>
        )}
        <div id="papers">
          {groups.map((g) => (
            <section class="topic" id={g.id}>
              {groups.length > 1 && <h2>{g.name}</h2>}
              <div class="grid">
                {g.items.map((e) => (
                  <EntryCard
                    lang={lang}
                    href={path(lang, `research/${splitId(e.id).slug}`)}
                    title={e.data.title}
                    description={e.data.description}
                    pillars={e.data.pillars}
                    meta={`${e.data.paper.authors[0]}${e.data.paper.authors.length > 1 ? " et al." : ""} · ${e.data.paper.year} · ${e.data.paper.venue}`}
                    draft={e.data.draft}
                    sdgs={e.data.sdgs.map((s) => s.goal)}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      </>
    )}
  </div>
</Base>

<style>
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-bottom: 2rem;
    font-size: var(--step--1);
  }
  .topics span {
    font-family: var(--font-mono);
    color: var(--graphite-soft);
  }
  .topic {
    margin-bottom: 2.5rem;
    scroll-margin-top: 5rem;
  }
  .topic h2 {
    font-size: var(--step-1);
    margin-bottom: 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .empty {
    max-width: 40rem;
    padding: 2rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--graphite-soft);
  }
</style>

<style is:global>
  /* tema sem nenhum cartão visível (filtro ativo) some da lista */
  #papers .topic:not(:has(.card:not([hidden]))) {
    display: none;
  }
</style>
