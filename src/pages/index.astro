---
// Raiz: envia o visitante para o idioma do navegador (sem JS, mostra os três links).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cobotics Hub</title>
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="pt-BR" href="/pt/" />
    <link rel="alternate" hreflang="es" href="/es/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <script is:inline>
      (function () {
        var supported = ["pt", "es", "en"];
        var prefs = navigator.languages || [navigator.language || "en"];
        for (var i = 0; i < prefs.length; i++) {
          var code = String(prefs[i]).slice(0, 2).toLowerCase();
          if (supported.indexOf(code) !== -1) return location.replace("/" + code + "/");
        }
        location.replace("/en/");
      })();
    </script>
    <style>
      body { font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; }
      a { margin: 0 0.75rem; }
    </style>
  </head>
  <body>
    <p><a href="/en/">English</a><a href="/pt/">Português</a><a href="/es/">Español</a></p>
  </body>
</html>
